# 管理员账号，首次启动会自动创建。
ADMIN_USERNAME=admin
ADMIN_PASSWORD=infinite-canvas

# JWT 登录密钥和过期时间，正式部署请修改 JWT_SECRET。
JWT_SECRET=infinite-canvas
JWT_EXPIRE_HOURS=168

# 后端默认监听 8080，如需本地开发修改端口再取消注释。
# Docker 镜像内前端固定监听 3000，避免覆盖前端 PORT。
# PORT=8080

# 公开访问地址，用于把本地上传的 Seedance 参考图/视频暴露给火山方舟拉取。
# 线上部署时填写站点根地址，例如：https://your-domain.example.com
# PUBLIC_BASE_URL=https://your-domain.example.com

# 前端开发代理默认使用 http://127.0.0.1:8080，如后端开发端口不同，启动前端时可单独设置 API_BASE_URL。
# API_BASE_URL=http://127.0.0.1:8080

# 受控 Mac CLI helper 默认关闭。仅在本机开发、确认需要检测固定 CLI 版本时启用。
# helper 不安装或登录 CLI，不执行用户填写的路径、任意参数或真实模型请求。
CLI_HELPER_ENABLED=false
# 启用时必须同时配置受信清单路径和 Ed25519 公钥（Base64）；清单不含密钥。
# CLI_HELPER_MANIFEST=/absolute/path/to/cli-helper-manifest.json
# CLI_HELPER_PUBLIC_KEY=<base64-ed25519-public-key>
# 正式 Mac 安装优先使用权限为 0600 的公钥文件，避免把公钥内容复制到环境文件。
# CLI_HELPER_PUBLIC_KEY_FILE=/absolute/path/to/cli-helper-public-key.txt
# Web 后端与独立 helper 只通过权限为 0600 的 Unix Socket 通信；共享密钥至少 32 个随机字节。
# CLI_HELPER_SOCKET=/absolute/private/directory/infinite-canvas-cli-helper.sock
# CLI_HELPER_SHARED_SECRET=<base64-encoded-random-32-bytes>
# 正式 Mac 安装优先使用权限为 0600 的共享密钥文件，LaunchAgent 和命令行不携带密钥正文。
# CLI_HELPER_SHARED_SECRET_FILE=/absolute/path/to/cli-helper-shared-secret

# 数据库配置，默认使用本地 SQLite。
STORAGE_DRIVER=sqlite
# sqlite: DATABASE_DSN=data/infinite-canvas.db
# Docker 部署时建议使用绝对路径，避免工作目录变化后写入临时库：DATABASE_DSN=/app/data/infinite-canvas.db
# mysql 目标库不存在时会尝试自动创建，账号需有 CREATE 权限。
# mysql: DATABASE_DSN=user:password@tcp(127.0.0.1:3306)/infinite_canvas?parseTime=true
# postgres 目标库不存在时会尝试自动创建，账号需有 CREATEDB 权限。
# postgres: DATABASE_DSN=postgres://user:password@127.0.0.1:5432/infinite_canvas?sslmode=disable
DATABASE_DSN=data/infinite-canvas.db

# 多实例部署时配置共享 Redis 请求预算；留空继续使用单进程限流。
# Redis 不可用时后端会安全失败，不会静默退回单进程预算。
# REQUEST_BUDGET_REDIS_URL=redis://user:password@127.0.0.1:6379/0
# REQUEST_BUDGET_REDIS_PREFIX=infinite-canvas:request-budget
